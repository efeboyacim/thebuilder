 "residual_rules": [
  {
   "id": "X1",
   "text": "Payday rule: if the customer says on which weekday they are paid (for example \"I get paid on Thursdays\"), persuasion attempt 1 for every product proposes the first business day after their next payday that comes after today, instead of the third business day after today. It must still be today or later, a business day and on or before the product's deadline; if it is after the deadline, propose the deadline.",
   "stage": "negotiate",
   "class": "flow",
   "trigger": "the customer says on which weekday they are paid",
   "free_mode": true,
   "refs": [
    "R50"
   ]
  },
  {
   "id": "X2",
   "text": "Before identity is verified, when the person asks a question in reply to the person check, answer it without giving any reason for the call and without mentioning arrears, debt, collections, a payment, an amount or any product (for example: I can only discuss that with {{title}} {{last_name}}); the check question asked after the answer is the second ask.",
   "stage": "open",
   "class": "speech",
   "trigger": "",
   "free_mode": false,
   "refs": [
    "R7",
    "R11"
   ]
  },
  {
   "id": "X3",
   "text": "Never offer a discount, a waiver, a payment plan or anything the material does not mention; on a request for a new plan describe no plan.",
   "stage": "negotiate",
   "class": "speech",
   "trigger": "",
   "free_mode": false,
   "refs": [
    "R52",
    "R53"
   ]
  },
  {
   "id": "X4",
   "text": "When a customer disputes a product (not their account, never had it, closed or settled long ago), do not argue.",
   "stage": "negotiate",
   "class": "speech",
   "trigger": "",
   "free_mode": false,
   "refs": [
    "R59"
   ]
  },
  {
   "id": "X5",
   "text": "A person who is not the customer learns nothing about the accounts, even if they offer to pay, and may not answer the security questions.",
   "stage": "third",
   "class": "speech",
   "trigger": "",
   "free_mode": false,
   "refs": [
    "R20"
   ]
  }
 ],
