{
 "spec_version": "0",
 "call_variables": [
  {
   "name": "customer_id",
   "meaning": "The customer's id; sent with every tool call."
  },
  {
   "name": "first_name",
   "meaning": "First name of the person the call is for."
  },
  {
   "name": "last_name",
   "meaning": "Last name of the person the call is for."
  },
  {
   "name": "title",
   "meaning": "Title used to address the customer, together with the last name (e.g. Mrs Moreau)."
  },
  {
   "name": "now",
   "meaning": "The date and time of the call; every date and time rule is measured from it."
  }
 ],
