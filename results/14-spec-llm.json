 "residual_rules": [
  {
   "id": "X1",
   "text": "After a hardship mention the agent makes no persuasion attempt, but if the customer still names a date or an amount themselves, the promise is handled and recorded under the date and amount rules.",
   "stage": "negotiate",
   "class": "flow",
   "trigger": "after a hardship mention, the customer names a date or an amount themselves",
   "refs": [
    "R42"
   ]
  },
  {
   "id": "X2",
   "text": "Never offer a discount, a waiver, an instalment plan or any term that is not in the brief.",
   "stage": "any",
   "class": "speech",
   "trigger": "",
   "refs": [
    "R43"
   ]
  },
  {
   "id": "X3",
   "text": "On a request for a new payment plan or lower instalments, do not describe a plan; only transfer.",
   "stage": "negotiate",
   "class": "speech",
   "trigger": "",
   "refs": [
    "R51"
   ]
  },
  {
   "id": "X4",
   "text": "On a restructuring request, promises already recorded stay; promises agreed but not yet recorded are not recorded (no create_promise call), and no add_note is made before or after the transfer.",
   "stage": "confirm",
   "class": "flow",
   "trigger": "restructuring request while promises are agreed but not yet recorded",
   "refs": [
    "R76"
   ]
  },
  {
   "id": "X5",
   "text": "When the customer disputes a product, do not argue.",
   "stage": "negotiate",
   "class": "speech",
   "trigger": "",
   "refs": [
    "R75"
   ]
  },
  {
   "id": "X6",
   "text": "If verify_identity returns ok false because it cannot read the answer, ask the same question again; this is not a wrong answer.",
   "stage": "identity",
   "class": "flow",
   "trigger": "verify_identity returns ok false for an unreadable answer",
   "refs": [
    "R16"
   ]
  },
  {
   "id": "X7",
   "text": "A date or an amount the customer proposes is never a refusal and uses no persuasion attempt; it is checked against the date and amount rules.",
   "stage": "negotiate",
   "class": "flow",
   "trigger": "the customer proposes a date or an amount",
   "refs": [
    "R37"
   ]
  },
  {
   "id": "X8",
   "text": "Never ask \"how much can you pay?\"; the agent proposes every amount.",
   "stage": "negotiate",
   "class": "speech",
   "trigger": "",
   "refs": [
    "R32"
   ]
  },
  {
   "id": "X9",
   "text": "When create_promise fails twice for one product among several, tell the customer at that point that this promise could not be recorded, keep the promises already recorded, and continue.",
   "stage": "confirm",
   "class": "speech",
   "trigger": "",
   "refs": [
    "R77"
   ]
  }
 ],
