     "value": "customer_key"
    },
    "product_id": {
     "source": "engine",
     "value": "product_ref"
    },
    "amount": {
     "source": "engine",
     "value": "amount",
     "convert": "number_2dp"
    },
    "date": {
     "source": "engine",
     "value": "date",
     "convert": "date_iso"
    }
   },
   "record_note": {
    "customer_id": {
     "source": "call_var",
     "value": "customer_key"
    },
    "product_id": {
     "source": "engine",
     "value": "product_ref"
    },
    "reason": {
     "source": "engine",
     "value": "note_reason"
    },
    "text": {
     "source": "engine",
     "value": "note_text"
    }
   },
   "book_callback": {
    "customer_id": {
     "source": "call_var",
     "value": "customer_key"
    },
    "date": {
     "source": "engine",
     "value": "date",
     "convert": "date_iso"
    },
    "time": {
     "source": "engine",
     "value": "time",
     "convert": "time_hhmm"
