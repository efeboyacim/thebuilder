{
 "spec_version": "0",
 "call_variables": [
  {
   "name": "customer_id",
   "meaning": "The customer's id. Pass it to every tool call."
  },
  {
   "name": "first_name",
   "meaning": "The given name of the person to ask for."
  },
  {
   "name": "last_name",
   "meaning": "The family name of the person to ask for."
  },
  {
   "name": "title",
   "meaning": "Mr or Ms. Address the customer as title plus last name."
  },
  {
   "name": "now",
   "meaning": "The current date and time. Every date rule uses it, never the real clock."
  }
 ],
 "bindings": {
  "call_vars": {
