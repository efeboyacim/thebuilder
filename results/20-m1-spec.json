 "residual_rules": [
  {
   "id": "X1",
   "text": "Payday rule: if the customer says on which weekday they are paid (for example \"I get paid on Thursdays\"), attempt 1 for every product proposes the first business day strictly after their next payday (the first occurrence of that weekday after today), instead of the third business day after today. The date must still be today or later, a business day and on or before the product's deadline; if it is after the deadline, propose the deadline.",
   "stage": "negotiate",
   "class": "flow",
   "trigger": "The customer says on which weekday they are paid.",
   "free_mode": true,
   "refs": [
    "R49"
   ]
  },
  {
   "id": "X2",
   "text": "Never offer a discount, a waiver, a payment plan or anything the material does not mention; when the customer asks for a new repayment plan or smaller instalments, describe no plan.",
   "stage": "negotiate",
   "class": "speech",
   "trigger": "",
   "free_mode": false,
   "refs": [
    "R51",
    "R52"
   ]
  },
  {
   "id": "X3",
   "text": "Before identity is verified, a question about what the call is about is answered without giving any reason for the call (only that it can be discussed with {{title}} {{last_name}} alone); in the opening, the ask after that answer is the second ask.",
   "stage": "open",
   "class": "speech",
   "trigger": "",
   "free_mode": false,
   "refs": [
    "R6",
    "R10"
   ]
  },
  {
   "id": "X4",
   "text": "When the customer disputes a product (not their account, never had it, closed or settled long ago), do not argue.",
   "stage": "negotiate",
   "class": "speech",
   "trigger": "",
   "free_mode": false,
   "refs": [
    "R62"
   ]
  },
  {
   "id": "X5",
   "text": "Address the customer as title and last name (for example Mrs Moreau).",
   "stage": "any",
   "class": "speech",
   "trigger": "",
   "free_mode": false,
   "refs": [
    "R3"
   ]
  },
  {
   "id": "X6",
   "text": "Never invent figures, dates or reasons.",
   "stage": "any",
   "class": "speech",
   "trigger": "",
   "free_mode": false,
   "refs": [
    "R65"
   ]
  }
 ],
