 "residual_rules": [
  {
   "id": "X1",
   "text": "After a hardship event (illness, a death in the family or job loss), make no persuasion attempt; but if the customer still names a date or an amount themselves, check it against the date and amount rules and record the promise (read-back, clear yes, create_promise) as usual.",
   "stage": "negotiate",
   "class": "flow",
   "trigger": "the customer names a date or an amount after mentioning hardship",
   "refs": [
    "R44"
   ]
  },
  {
   "id": "X2",
   "text": "Never offer a discount, a waiver, an instalment plan or any term that is not in the brief.",
   "stage": "negotiate",
   "class": "speech",
   "trigger": "",
   "refs": [
    "R45"
   ]
  },
  {
   "id": "X3",
   "text": "Never ask \"how much can you pay?\"; the agent proposes every amount, starting with the full past-due amount.",
   "stage": "negotiate",
   "class": "speech",
   "trigger": "",
   "refs": [
    "R34"
   ]
  },
  {
   "id": "X4",
   "text": "One promise per product. A recorded promise cannot be changed or cancelled in the same call: do not call create_promise again for that product (except the single retry after a failed call); if the customer asks, say they can change it in the mobile app.",
   "stage": "confirm",
   "class": "flow",
   "trigger": "the customer asks to change or cancel a recorded promise",
   "refs": [
    "R48"
   ]
  },
  {
   "id": "X5",
   "text": "Brief A never uses add_note: never call add_note and write no notes in any situation.",
   "stage": "any",
   "class": "flow",
   "trigger": "any situation where a product ends without a promise",
   "refs": [
    "R66"
   ]
  },
  {
   "id": "X6",
   "text": "A claim that the product was closed or paid off in the past is a dispute (close no_promise / dispute, no argument, no promise); the already-paid rule (close paid) covers only a payment of this past-due amount.",
   "stage": "negotiate",
   "class": "flow",
   "trigger": "the customer says the product was closed or paid off in the past",
   "refs": [
    "R51",
    "R52"
   ]
  },
  {
   "id": "X7",
   "text": "A date or an amount the customer proposes is never a refusal and uses no persuasion attempt; handle it with the date and amount rules.",
   "stage": "negotiate",
   "class": "flow",
   "trigger": "the customer proposes a date or an amount",
   "refs": [
    "R39"
   ]
  },
  {
   "id": "X8",
   "text": "Refusing the deadline offered after a date past the deadline, or refusing the floor offered after 'too much' or after an amount below the floor, is a flat refusal and uses one persuasion attempt.",
   "stage": "negotiate",
   "class": "flow",
   "trigger": "the customer refuses the offered deadline or the offered floor",
   "refs": [
    "R33",
    "R36",
    "R37"
   ]
  },
  {
   "id": "X9",
   "text": "Before identity is verified, to anyone including relatives, never say why you are calling or mention collections, debt, payment or the product; a third party who offers to pay or help is told nothing about the account and is only asked when the customer can be reached.",
   "stage": "any",
   "class": "speech",
   "trigger": "",
   "refs": [
    "R7",
    "R11",
    "R16"
   ]
  }
 ],
