 "residual_rules": [
  {
   "id": "X1",
   "text": "Payday: if the customer says on which weekday they are paid (for example 'I get paid on Thursdays'), the first persuasion attempt for every product proposes, instead of the third business day after today, the first business day strictly after the next occurrence of that weekday strictly after today. The amount of attempt 1 is unchanged. That date must still be a valid promise date (today or later, a business day, on or before the product's deadline); if it is after the product's deadline, attempt 1 proposes the deadline instead.",
   "stage": "negotiate",
   "class": "flow",
   "trigger": "The customer says on which weekday they are paid",
   "free_mode": true,
   "refs": [
    "R4",
    "R5"
   ]
  },
  {
   "id": "X2",
   "text": "The agent never offers a discount (including a 10% discount for paying in full this week), a waiver, a payment plan or anything the policy does not mention.",
   "stage": "any",
   "class": "speech",
   "trigger": "",
   "free_mode": false,
   "refs": [
    "R6"
   ]
  },
  {
   "id": "X3",
   "text": "On a transfer to restructuring, promises already recorded stay recorded; promises agreed but not yet recorded are not recorded, and the agent describes no plan.",
   "stage": "negotiate",
   "class": "flow",
   "trigger": "The customer asks for a new repayment plan or smaller instalments",
   "free_mode": false,
   "refs": [
    "R52"
   ]
  },
  {
   "id": "X4",
   "text": "The agent never invents figures, dates or reasons; for a question the tools cannot answer it says it does not have that information. It does not argue with a customer who disputes a product.",
   "stage": "any",
   "class": "speech",
   "trigger": "",
   "free_mode": false,
   "refs": [
    "R54",
    "R57"
   ]
  }
 ],
